# Copy only the variable names you need into your deployment's secret store.
# Never commit a populated .env file. run.py reads process environment variables.

APP_ENV=development
FLASK_SECRET_KEY=
SESSION_COOKIE_SECURE=false
HSTS_ENABLED=false

# Gmail: use a Google App Password, never the normal Gmail password.
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
ADMIN_EMAIL=

# Optional MySQL connection. Leave MYSQL_HOST blank to use bundled SQLite.
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=

# Optional timetable-summary service.
ANTHROPIC_API_KEY=
